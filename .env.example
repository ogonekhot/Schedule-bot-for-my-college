# Telegram
BOT_TOKEN=
# Если Bot API запущен на том же Linux-хосте, это значение подходит для docker compose.
BOT_API_BASE_URL=http://host.docker.internal:8081
BOT_API_IS_LOCAL=true
BOT_TIMEZONE=Europe/Moscow

# Аккаунт личного кабинета на каждую группу. Внешние кавычки обязательны.
SCHEDULE_ACCOUNTS_JSON='{"Т9-ИП-24-1":{"login":"LOGIN","password":"PASSWORD"},"Т9-ИП-24-2":{"login":"LOGIN","password":"PASSWORD"}}'
# Аккаунты новых групп, добавленных через бота. Файл должен быть постоянным.
SCHEDULE_ACCOUNTS_FILE=data/accounts.json
SCHEDULE_UPDATE_ON_STARTUP=true
SCHEDULE_UPDATE_INTERVAL_MINUTES=360
SCHEDULE_UPDATE_MAX_ATTEMPTS=3
SCHEDULE_UPDATE_RETRY_SECONDS=10
SCHEDULE_PAGE_TIMEOUT_SECONDS=35
SCHEDULE_BROWSER=chromium
SCHEDULE_HEADLESS=true

# Менять адреса нужно только если колледж перенесёт личный кабинет.
COLLEGE_LOGIN_URL=http://lk.stu.lipetsk.ru/
COLLEGE_SCHEDULE_URL=http://lk.stu.lipetsk.ru/education/0/5:136841076/

# MariaDB из docker-compose.yml
DB_HOST=db
DB_PORT=3306
DB_NAME=schedule_bot
DB_USER=schedule_bot
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_me
